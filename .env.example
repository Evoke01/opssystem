# Frontend API base.
# Leave blank for same-origin local development via `npm run dev`.
VITE_API_BASE_URL=""

# Backend CORS allow-list for browser requests.
# Use a comma-separated list when you have multiple frontend domains.
FRONTEND_ORIGIN="http://localhost:3000,http://localhost:4173,http://localhost:5173,https://opssystem.pages.dev"

# Admin login
ADMIN_PASSWORD="change-me"

# Email configuration
RESEND_API_KEY="re_xxx"
TEAM_LEAD_EMAIL="teamlead@example.com"

# Supabase configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
